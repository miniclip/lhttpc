[{config, [
        #{ files => ["src/**/*.erl"],
           ruleset => erl_files,
           rules => [{elvis_style, dont_repeat_yourself, disable},
                     {elvis_style, no_if_expression, disable},
                     {elvis_style, max_function_arity, disable},
                     {elvis_style, no_throw, disable},
                     {elvis_style, no_receive_without_timeout, disable}] },
        #{ files => ["test/**/*.erl"],
           ruleset => erl_files_test,
           rules => [{elvis_style, no_invalid_dynamic_calls, disable},
                     {elvis_style, function_naming_convention, disable},
                     {elvis_style, no_if_expression, disable},
                     {elvis_style, atom_naming_convention, disable},
                     {elvis_style, no_receive_without_timeout, disable}] },
        #{ files => ["rebar.config"],
           ruleset => rebar_config }
    ]},
    {verbose, true}
].
